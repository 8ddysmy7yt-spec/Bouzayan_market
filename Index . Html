  text-align:center;color:var(--muted);font-size:12px;line-height:2
}
footer strong{color:var(--green)}
.whatsapp-float{
  position:fixed;bottom:19px;left:18px;z-index:30;
  background:#20c879;color:#05271b;border-radius:50px;
