  {id:"tiktok-coins",cat:"other",icon:"🪙",name:"TikTok Coins",desc:"اختار الكمية اللي تحب عليها وراسلنا لمعرفة السعر والتوفر.",custom:true,quantity:true,label:"كمية العملات",placeholder:"اكتب الكمية المطلوبة"},
  {id:"sponsoring",cat:"other",icon:"📢",name:"Facebook / Instagram Sponsoring",desc:"خدمات الإعلانات الممولة. تواصل معنا باش نفهمو طلبك ونعطيوك السعر.",custom:true,label:"تفاصيل الإعلان",placeholder:"اكتب نوع الإعلان والميزانية والهدف"},
  {id:"other-app",cat:"other",icon:"💎",name:"شحن تطبيق آخر",desc:"تحب تشحن تطبيق موش موجود؟ ابعث اسم التطبيق وصورة العرض على WhatsApp باش نعطيوك السعر.",custom:true,label:"اسم التطبيق والعرض",placeholder:"اكتب اسم التطبيق والعرض المطلوب"}
];

const grid=document.getElementById("grid");
const search=document.getElementById("search");
const empty=document.getElementById("empty");
let activeCategory="all";
let currentService=null;

function money(v){return Number(v).toLocaleString("en-US")+" DT"}

function render(){
  const term=search.value.trim().toLowerCase();
  const filtered=services.filter(s=>{
    const categoryMatch=activeCategory==="all"||s.cat===activeCategory;
    const text=[s.name,s.desc,s.id,...(s.offers||[]).map(o=>o.name)].join(" ").toLowerCase();
    return categoryMatch&&text.includes(term);
  });
  grid.innerHTML="";
  empty.style.display=filtered.length?"none":"block";

  filtered.forEach(s=>{
    const card=document.createElement("article");
    card.className="card";
    let prices="";
    if(s.offers){
      prices=s.offers.map(o=>{
        let right="";
        if(o.d17!==undefined){
          right=`<span>D17: <b>${money(o.d17)}</b></span>`;
          if(o.sold!==undefined){
            right+=o.sold===null
              ? `<span>Sold: <b class="unavailable">غير متاح</b></span>`
              : `<span>Sold: <b>${money(o.sold)}</b></span>`;
          }
        }else{
          right=`<span><b>${money(o.price)}</b></span>`;
        }
        return `<div class="price-row"><span>${o.name}</span>${right}</div>`;
      }).join("");
    }else if(s.rate){
      prices=`<div class="price-row"><span>السعر لكل 1K</span><b>${money(s.rate)}</b></div>`;
    }else{
      prices=`<div class="price-row"><span>السعر</span><b>حسب الطلب</b></div>`;
    }
    card.innerHTML=`
      <div class="card-top">
        <div class="card-icon">${s.icon}</div>
        <div><h3>${s.name}</h3><small>${categoryName(s.cat)}</small></div>
      </div>
      <div class="card-desc">${s.desc}</div>
      <div class="price-list">${prices}</div>
      <button class="btn btn-primary" data-order="${s.id}">اطلب الخدمة ←</button>
    `;
    grid.appendChild(card);
  });
}
function categoryName(c){
  return {games:"الألعاب",subscriptions:"الاشتراكات",internet:"الإنترنت",social:"التواصل الاجتماعي",other:"خدمات أخرى"}[c]||"";
}

document.getElementById("filters").addEventListener("click",e=>{
  const b=e.target.closest("button[data-cat]");
  if(!b)return;
  activeCategory=b.dataset.cat;
  document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x===b));
  render();
});
search.addEventListener("input",render);

const modal=document.getElementById("orderModal");
const offerSelect=document.getElementById("offer");
const quantityInput=document.getElementById("quantity");
const paymentSelect=document.getElementById("payment");

function openOrder(id){
  currentService=services.find(s=>s.id===id);
  if(!currentService)return;
  document.getElementById("serviceName").value=currentService.name;
  document.getElementById("modalTitle").textContent="طلب "+currentService.name;

  const hasOffers=!!currentService.offers;
  document.getElementById("offerField").style.display=hasOffers?"block":"none";
  document.getElementById("quantityField").style.display=(currentService.rate||currentService.quantity)?"block":"none";
  document.getElementById("linkField").style.display=currentService.label?"block":"none";
  document.getElementById("linkLabel").textContent=currentService.label||"الرابط أو المعلومات";
  document.getElementById("customerLink").placeholder=currentService.placeholder||"أدخل المعلومات المطلوبة";
  document.getElementById("customerLink").value="";
  document.getElementById("quantity").value=1;
  document.getElementById("phone").value="";
  document.getElementById("notes").value="";
  paymentSelect.value="D17";

  offerSelect.innerHTML="";
  if(hasOffers){
    currentService.offers.forEach((o,i)=>{
      const op=document.createElement("option");
      op.value=i;
      op.textContent=o.name+
        (o.d17!==undefined?` — D17 ${money(o.d17)}${o.sold!==undefined?(o.sold===null?" — Sold غير متاح":` — Sold ${money(o.sold)}`):""}`:
        ` — ${money(o.price)}`);
      offerSelect.appendChild(op);
    });
  }
  updateTotal();
  modal.classList.add("show");
}
function getPrice(){
  if(!currentService)return null;
  if(currentService.custom)return null;
  if(currentService.rate){
    const qty=Math.max(1,Number(quantityInput.value)||1);
    return currentService.rate*qty;
  }
  if(currentService.offers){
    const o=currentService.offers[Number(offerSelect.value)||0];
    if(!o)return null;
    if(o.d17!==undefined){
      if(paymentSelect.value==="D17")return o.d17;
      if(o.sold!==undefined&&o.sold!==null)return o.sold;
      return null;
    }
    return o.price;
  }
  return null;
}
function updateTotal(){
  const price=getPrice();
  document.getElementById("totalPrice").textContent=
    price===null?"حسب الطلب":money(price);
}
offerSelect.addEventListener("change",updateTotal);
quantityInput.addEventListener("input",updateTotal);
paymentSelect.addEventListener("change",updateTotal);

grid.addEventListener("click",e=>{
  const b=e.target.closest("[data-order]");
  if(b)openOrder(b.dataset.order);
});
document.getElementById("closeModal").onclick=()=>modal.classList.remove("show");
modal.addEventListener("click",e=>{if(e.target===modal)modal.classList.remove("show")});

document.getElementById("sendOrder").addEventListener("click",()=>{
  if(!currentService)return;
  const customerLink=document.getElementById("customerLink").value.trim();
  if(currentService.label&&!customerLink){
    alert("من فضلك أدخل المعلومات المطلوبة لإتمام الطلب.");
    document.getElementById("customerLink").focus();
    return;
  }
  const payment=paymentSelect.value;
  let offerText="حسب الطلب";
  if(currentService.offers){
    const o=currentService.offers[Number(offerSelect.value)||0];
    offerText=o.name;
    if(o.d17!==undefined&&payment==="Sold"&&o.sold===null){
      alert("العرض هذا غير متاح بطريقة الدفع المختارة. اختار D17 أو تواصل معنا.");
      return;
    }
  }
  const price=getPrice();
  const quantity=currentService.rate||currentService.quantity
    ? Math.max(1,Number(quantityInput.value)||1)
    : null;
  const phone=document.getElementById("phone").value.trim();
  const notes=document.getElementById("notes").value.trim();

  let message=
`🛍️ *طلب جديد من BOUZAYAN MARKET*
━━━━━━━━━━━━━━
📦 الخدمة: ${currentService.name}
🎯 العرض: ${offerText}`;
  if(quantity!==null)message+=`\n🔢 الكمية: ${quantity}${currentService.rate?"K":""}`;
  if(customerLink)message+=`\n🔗 الرابط / التفاصيل: ${customerLink}`;
  message+=`\n💳 طريقة الدفع: ${payment}`;
  message+=`\n💰 السعر: ${price===null?"حسب الطلب":money(price)}`;
  if(phone)message+=`\n📱 رقم الهاتف: ${phone}`;
  if(notes)message+=`\n📝 ملاحظات: ${notes}`;
  message+=`\n━━━━━━━━━━━━━━\nشكراً لكم ❤️`;

  window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(message)}`,"_blank");
});

document.getElementById("year").textContent=new Date().getFullYear();
render();
</script>
