  border-radius:9px;font-size:12px;
}
.price-row b{color:var(--green);white-space:nowrap}
.unavailable{color:var(--danger)!important}
.card .btn{margin-top:auto;width:100%;padding:11px;font-size:13px}
.empty{
  display:none;text-align:center;padding:35px;
  color:var(--muted);background:var(--panel);border-radius:15px
}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:25px 0}
.info{
  background:var(--panel);border:1px solid var(--line);
  border-radius:15px;padding:17px;text-align:center
