  background:var(--panel);color:var(--muted);
  border-radius:30px;padding:9px 14px;font-size:13px;
}
.filter.active,.filter:hover{
  background:rgba(32,214,160,.13);border-color:var(--green);color:var(--green)
}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card{
  background:linear-gradient(145deg,var(--panel),#0a222b);
  border:1px solid var(--line);border-radius:17px;
  padding:17px;display:flex;flex-direction:column;min-width:0;
  transition:.2s;
