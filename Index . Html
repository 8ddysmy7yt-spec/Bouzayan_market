  font-weight:800;transition:.2s;display:inline-flex;
  align-items:center;justify-content:center;gap:7px;
}
.btn-primary{background:linear-gradient(135deg,var(--green),var(--blue));color:#06232a}
.btn-secondary{background:rgba(255,255,255,.07);color:var(--text);border:1px solid var(--line)}
.btn:hover{transform:translateY(-2px)}
.notice{
  margin:22px auto;padding:18px 19px;
  background:rgba(32,214,160,.07);
  border:1px solid rgba(32,214,160,.22);
  border-radius:16px;line-height:1.9;
}
.notice strong{color:var(--green)}
.notice p{margin:7px 0 0;color:#c7dcdd;font-size:14px}
.search-wrap{margin:27px auto 18px;position:relative}
.search-wrap input{
  width:100%;padding:17px 48px 17px 16px;
  background:var(--panel);border:1px solid var(--line);
  color:white;border-radius:15px;outline:none;font-size:15px;
}
