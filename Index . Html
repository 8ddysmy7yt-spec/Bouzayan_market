  {id:"youtube-subs",cat:"social",icon:"🔔",name:"YouTube Subscribers",desc:"مشتركو YouTube – السعر لكل 1K.",rate:100,unit:"Subscribers",label:"رابط القناة",placeholder:"ضع رابط قناة YouTube"},
  {id:"verification",cat:"social",icon:"☑️",name:"Facebook / Instagram Verification",desc:"خدمة طلب توثيق حساب Facebook أو Instagram. التوفر والشروط حسب المنصة.",offers:[
    {name:"First-time verification",d17:15,sold:18},
    {name:"Second time or more",d17:25,sold:28}
  ],label:"رابط الحساب",placeholder:"ضع رابط الحساب المراد تقديم طلب توثيقه"},

