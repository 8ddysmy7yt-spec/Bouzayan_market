.search-icon{position:absolute;right:17px;top:15px;font-size:19px}
.section-title{display:flex;justify-content:space-between;align-items:end;gap:10px;margin:32px 0 16px}
.section-title h2{font-size:22px;margin:0}
.section-title p{font-size:12px;color:var(--muted);margin:5px 0 0}
.filters{display:flex;gap:8px;overflow-x:auto;padding:2px 0 12px}
.filter{
